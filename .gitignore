# Legacy opencode agent directory (pre-pi review pipeline) — kept ignored so
# historical tooling cannot dirty the workspace. Review skills today are
# installed by CI into .pi/skills/ (review.yml) and are never committed.
/.agents

# Review state cache — used for incremental reviews on synchronize
/.review-state

# Per-issue workflow records — intentionally local until a task chooses to
# commit them; never picked up by a blanket git add -A.
/docs/issue-workflows/
