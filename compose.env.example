# League Tokens Backend — Environment Configuration
# Copy this file to set up your environment. Never commit a .env file.
# Secrets are read from /run/secrets/<name> — see "Secret files" below.

# ── Postgres ──────────────────────────────────────────────────────────
PG_DATABASE=league_tokens
PG_USER=postgres
PG_HOST=localhost
PG_PORT=5432
# SSL mode. "disable" is fine for local dev (localhost, no TLS).
# Production must use "verify-full" (or at least "require") so the DB
# password — loaded as a secret — is never sent in cleartext (ADR-0006/0007).
PG_SSLMODE=disable
PG_MAX_CONNS=25

# ── HTTP ──────────────────────────────────────────────────────────────
HTTP_LISTEN_ADDR=:8080
HTTP_TRUSTED_PROXIES=

# ── Telemetry / Observability ─────────────────────────────────────────
OTLP_ENDPOINT=
SERVICE_NAME=league-tokens-backend
LOG_LEVEL=info
# Production must set json (default is text) — ADR-0006: text dev, JSON prod.
LOG_FORMAT=json

# ── Identity / Auth ───────────────────────────────────────────────────
SESSION_TTL=24h

# ── Schedule (game schedule provider) ─────────────────────────────────
# Placeholder host: nothing dials it until the schedule adapter lands (#34).
SCHEDULE_PROVIDER_URL=https://api.example.com/v1
SCHEDULE_SYNC_INTERVAL=5m
# Allow plain http:// for a local mock provider (dev only; the provider API
# key would otherwise travel in cleartext).
SCHEDULE_ALLOW_INSECURE_HTTP=false

# ── Feed (external data ingestion) ────────────────────────────────────
# Placeholder host: nothing dials it until the feed adapter lands (#17).
FEED_PROVIDER_URL=https://feed.example.com/v2
FEED_POLL_INTERVAL=1m
# Allow plain http:// for a local mock provider (dev only; the provider API
# key would otherwise travel in cleartext).
FEED_ALLOW_INSECURE_HTTP=false

# ── Game ──────────────────────────────────────────────────────────────
# (no env vars at Launch)

# ── Ledger ────────────────────────────────────────────────────────────
# (no env vars at Launch)

# ── Secret files (mounted at /run/secrets/<name> in Docker) ───────────
# pg_password       — Postgres password
# jwt_signing_key   — Ed25519 private key for JWT signing (PEM)
# provider_api_key  — API key for the external data provider
# otlp_token        — OTLP/gRPC authentication token (Grafana Cloud)
